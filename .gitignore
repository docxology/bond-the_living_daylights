.coverage
.coverage.*
.pytest_cache/
__pycache__/
*.pyc
.benchmarks/

# Egg-info from local installs (any location — guards against renamed-fork drift).
**/*.egg-info/

# Build output the vendored copy's own build writes into vendor/bond-api/ (setuptools).
vendor/**/build/

# Project-local virtualenvs (root .venv is shared)
.venv/

# Regenerable artifacts — git-ignored so script smoke tests leave the tree clean.
output/
